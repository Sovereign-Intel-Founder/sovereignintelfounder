{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceManifest",
  "type": "object",
  "properties": {
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "category": { "type": "string", "enum": ["canonical", "experiments", "historical"] },
          "evidence_class": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
          "source_path": { "type": "string" }
        },
        "required": ["id", "version", "category", "evidence_class", "source_path"]
      }
    }
  },
  "required": ["benchmarks"]
}
