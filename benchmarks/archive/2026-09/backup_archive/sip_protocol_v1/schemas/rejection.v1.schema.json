{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sip.rejection.v1",
  "title": "SIP Rejection Payload v1",
  "type": "object",
  "required": [
    "schema",
    "rejection_code",
    "message",
    "timestamp"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sip.rejection.v1"
    },
    "rejection_code": {
      "type": "string",
      "enum": [
        "schema_invalid",
        "canonicalization_invalid",
        "identity_mismatch",
        "signature_invalid",
        "commitment_mismatch",
        "destination_unauthorized",
        "nonce_reused",
        "sequence_invalid",
        "lineage_invalid",
        "state_transition_invalid",
        "capsule_expired",
        "cell_revoked",
        "resource_policy_denied"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
