{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sip.task_manifest.v1",
  "title": "SIP Task Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "task_type",
    "input_commitment",
    "created_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sip.task_manifest.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 36,
      "maxLength: 36
    },
    "task_type": {
      "type": "string",
      "enum": [
        "file_hash_verification",
        "dataset_integrity_check",
        "policy_evaluation",
        "reproducible_transformation",
        "bounded_audit"
      ]
    },
    "input_commitment": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
